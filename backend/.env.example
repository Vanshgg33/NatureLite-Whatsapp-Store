# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# MongoDB
MONGODB_URI=mongodb://localhost:27017/whatsapp-store
# Alias supported by config (use one key consistently)
MONGODB_URL=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# WhatsApp Provider
# Options: meta | 360dialog | 360dialog_sandbox
WHATSAPP_PROVIDER=meta
WHATSAPP_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-business-account-id
WHATSAPP_ACCESS_TOKEN=your-access-token
WHATSAPP_D360_API_KEY=
WHATSAPP_WEBHOOK_URL=https://your-public-backend-domain/api/v1/whatsapp/webhook
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-webhook-verify-token
WHATSAPP_APP_SECRET=your-app-secret

# 360dialog sandbox example values:
# WHATSAPP_PROVIDER=360dialog_sandbox
# WHATSAPP_API_URL=https://waba-sandbox.360dialog.io
# WHATSAPP_PHONE_NUMBER_ID=sandbox-does-not-use-phone-number-id
# WHATSAPP_ACCESS_TOKEN=sandbox-does-not-use-access-token
# WHATSAPP_D360_API_KEY=your-360dialog-sandbox-api-key

# 360dialog production example values:
# WHATSAPP_PROVIDER=360dialog
# WHATSAPP_API_URL=https://waba-v2.360dialog.io
# WHATSAPP_PHONE_NUMBER_ID=not-used-by-360dialog
# WHATSAPP_ACCESS_TOKEN=not-used-by-360dialog
# WHATSAPP_D360_API_KEY=your-360dialog-production-api-key

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Google Gemini API
GEMINI_API_KEY=your-gemini-api-key

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=xxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxx

# SMTP (Email Notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Naturelite Store <noreply@naturelite.com>

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3001

# Production notes:
# - Set NODE_ENV=production
# - Set FRONTEND_URL to your real frontend domain(s), comma-separated if needed
# - Ensure JWT_SECRET is strong and unique
# - On Render backend service, set Health Check Path to /api/v1/health
