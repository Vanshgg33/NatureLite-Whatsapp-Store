# Application
NODE_ENV=staging
PORT=7001
API_PREFIX=api/v1

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:8001

# MongoDB (sandbox/local)
MONGODB_URI=mongodb://localhost:27017/whatsapp-store-sandbox
MONGODB_URL=

# JWT
JWT_SECRET=replace-with-sandbox-jwt-secret
JWT_EXPIRES_IN=7d

# WhatsApp Provider (360dialog sandbox)
WHATSAPP_PROVIDER=360dialog_sandbox
WHATSAPP_API_URL=https://waba-sandbox.360dialog.io
WHATSAPP_PHONE_NUMBER_ID=sandbox
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_D360_API_KEY=replace-with-360dialog-sandbox-api-key
WHATSAPP_WEBHOOK_VERIFY_TOKEN=replace-with-sandbox-webhook-verify-token
WHATSAPP_APP_SECRET=

# Cloudinary
CLOUDINARY_CLOUD_NAME=replace-with-cloudinary-cloud-name
CLOUDINARY_API_KEY=replace-with-cloudinary-api-key
CLOUDINARY_API_SECRET=replace-with-cloudinary-api-secret

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Google Gemini API
GEMINI_API_KEY=replace-with-gemini-api-key

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=

# Interakt API Key
INTERAKT_API_KEY=

# SMTP (Email Notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Sandbox Store <noreply@example.com>