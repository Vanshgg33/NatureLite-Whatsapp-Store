# Application
NODE_ENV=staging
PORT=7001
API_PREFIX=api/v1

# MongoDB
# Use a separate database from 360production.
MONGODB_URI=mongodb://localhost:27017/whatsapp-store-sandbox
MONGODB_URL=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your-sandbox-jwt-secret-change-me
JWT_EXPIRES_IN=7d

# WhatsApp Provider
# Sandbox branch should use the sandbox provider only.
WHATSAPP_PROVIDER=360dialog_sandbox
WHATSAPP_API_URL=https://waba-sandbox.360dialog.io
WHATSAPP_PHONE_NUMBER_ID=sandbox
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_D360_API_KEY=your-360dialog-sandbox-api-key
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-sandbox-webhook-verify-token
WHATSAPP_APP_SECRET=

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Google Gemini API
GEMINI_API_KEY=your-gemini-api-key

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# SMTP (Email Notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Sandbox Store <noreply@example.com>

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:8001

# Render sandbox notes:
# - Set NODE_ENV=staging for the backend so the sandbox provider is allowed.
# - Use a separate MongoDB database from production.
# - Set FRONTEND_URL to the sandbox frontend domain when deployed.